  "item": [
    {
      "name": "01 It works - create a set",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.collectionVariables.set(\"setId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Demo-User",
            "value": "{{host}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/question-sets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "question-sets"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Philippine Literature\",\n  \"subject\": \"Literature\",\n  \"grade_level\": \"Grade 10\"\n}",
